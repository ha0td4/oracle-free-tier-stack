# STANDARD: 2 OCPU / 12 GB VM (~11.9 GB usable RAM), for you alone or a team of up to ~15.
# Container limits total 9,568 MiB, leaving room for the OS and page cache.
COMPOSE_PROFILES=n8n,omniroute,hermes,searxng,pocket-id,open-webui,crawl4ai,alloy,blackbox,homer
MEM_N8N=1g
N8N_HEAP_MB=768
MEM_OMNIROUTE=1536m
OMNIROUTE_HEAP_MB=1024
MEM_HERMES=3g
CPU_HERMES=1.5
MEM_SEARXNG=512m
MEM_CRAWL4AI=1536m
CPU_CRAWL4AI=1.0
MEM_POCKETID=256m
MEM_OPENWEBUI=1g
