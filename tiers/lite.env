# LITE: ~1 OCPU / 6 GB (reduced Oracle quota or a small VPS).
# No Crawl4AI: use Jina Reader (https://r.jina.ai/<url>, free tier is rate-limited; it sends the URL to a third party) instead.
# Keeps Pocket ID (light) so SSO still works. No Open WebUI: chat with Hermes on Telegram or Discord (add it in your own tier, about 768m).
COMPOSE_PROFILES=n8n,omniroute,hermes,searxng,pocket-id,alloy,blackbox,homer
MEM_N8N=768m
N8N_HEAP_MB=512
MEM_OMNIROUTE=768m
OMNIROUTE_HEAP_MB=512
MEM_HERMES=2g
CPU_HERMES=0.8
MEM_SEARXNG=384m
MEM_POCKETID=128m
