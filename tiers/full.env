# FULL = standard + Postgres/Valkey: 9,568 + 512 + 192 = 10,272 MiB of ~11.9 GiB usable on a 12 GB shape, a little over the
# ~85% rule (tight); drop Valkey first if RAM runs short.
COMPOSE_PROFILES=n8n,omniroute,hermes,searxng,pocket-id,open-webui,crawl4ai,alloy,blackbox,homer,postgres,valkey
MEM_N8N=1g
N8N_HEAP_MB=768
MEM_OMNIROUTE=1536m
OMNIROUTE_HEAP_MB=1024
MEM_HERMES=3g
CPU_HERMES=1.5
MEM_SEARXNG=512m
MEM_CRAWL4AI=1536m
CPU_CRAWL4AI=1.0
MEM_POCKETID=256m
MEM_OPENWEBUI=1g
MEM_POSTGRES=512m
