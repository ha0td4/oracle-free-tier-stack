# ./stack.sh init copies this to backup/backup.env.

# restic encryption password. SAVE IT in a password manager: without it the backups are useless.
RESTIC_PASSWORD=__GENERATE__

# Primary: Oracle Object Storage. Private Standard bucket "stack-backup" in the root compartment.
# Keys: Profile -> Customer secret keys (the secret is shown once). NAMESPACE: Tenancy details.
# The part after the bucket is a folder inside it (restic creates it): the bucket root stays free for other things.
PRIMARY_REPOSITORY=s3:https://NAMESPACE.compat.objectstorage.REGION.oraclecloud.com/stack-backup/oracle-stack
PRIMARY_AWS_ACCESS_KEY_ID=
PRIMARY_AWS_SECRET_ACCESS_KEY=
PRIMARY_AWS_DEFAULT_REGION=REGION

# Secondary (optional, recommended): another provider, in case the Oracle account is lost
# Cloudflare R2 (10 GB free): s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/stack-backup/oracle-stack   region: auto
# Backblaze B2 (10 GB free): s3:https://s3.REGION.backblazeb2.com/BUCKET/oracle-stack                    region: REGION
SECONDARY_REPOSITORY=
SECONDARY_AWS_ACCESS_KEY_ID=
SECONDARY_AWS_SECRET_ACCESS_KEY=
SECONDARY_AWS_DEFAULT_REGION=auto

STAGING_DIR=/var/backups/stack-staging
# The snapshots' host name in restic: the weekly forget/prune touches only snapshots with this host and the tag "stack"
BACKUP_HOST=oracle-stack
