    {
      "id": 5,
      "type": "logs",
      "title": "Container logs",
      "description": "Container stdout/stderr, newest first, each line prefixed with its container name. The search box is a case-insensitive regex. For a live tail, open this query in Explore and press Live.",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{source=\"docker\", stack=~\"$stack\", host=~\"$host\", container=~\"$container\"} |~ \"(?i)$search\" | line_format \"{{.container}}  {{__line__}}\"",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "enableInfiniteScrolling": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
