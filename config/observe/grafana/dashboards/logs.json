    {
      "id": 1,
      "type": "timeseries",
      "title": "Log lines per container",
      "description": "Log lines per container over time. Counted every minute by a Loki recording rule (since the hub was installed), so the search box does not filter it and any range is fast.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true,
          "expr": "sum by (container) (sum_over_time(loki:log_lines:count1m{source=\"docker\", stack=~\"$stack\", host=~\"$host\", container=~\"$container\"}[$__interval]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
