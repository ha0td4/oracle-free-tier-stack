          "editorMode": "code",
          "expr": "round(max by (host, container, service) (increase(container_oom_events_total{job=\"cadvisor\", container!=\"\", stack=~\"$stack\", host=~\"$host\", project=~\"$project\", container=~\"$container\"}[$__range])))",
