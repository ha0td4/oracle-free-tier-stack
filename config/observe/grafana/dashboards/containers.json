    {
      "id": 1,
      "type": "table",
      "title": "Containers",
      "description": "One row per running container, sorted by memory. CPU is a share of one core. RAM % is blank when the container has no memory limit. Restarts and OOM count over the selected range. Click a row to open its logs.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host, container, service) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\", container!=\"\", stack=~\"$stack\", host=~\"$host\", project=~\"$project\", container=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host, container, service) (container_memory_working_set_bytes{job=\"cadvisor\", container!=\"\", stack=~\"$stack\", host=~\"$host\", project=~\"$project\", container=~\"$container\"})",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host, container, service) (container_spec_memory_limit_bytes{job=\"cadvisor\", container!=\"\", stack=~\"$stack\", host=~\"$host\", project=~\"$project\", container=~\"$container\"} > 0)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host, container, service) (container_memory_working_set_bytes{job=\"cadvisor\", container!=\"\", stack=~\"$stack\", host=~\"$host\", project=~\"$project\", container=~\"$container\"}) / max by (host, container, service) (container_spec_memory_limit_bytes{job=\"cadvisor\", container!=\"\", stack=~\"$stack\", host=~\"$host\", project=~\"$project\", container=~\"$container\"} > 0)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "time() - max by (host, container, service) (container_start_time_seconds{job=\"cadvisor\", container!=\"\", stack=~\"$stack\", host=~\"$host\", project=~\"$project\", container=~\"$container\"})",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host, container, service) (changes(container_start_time_seconds{job=\"cadvisor\", container!=\"\", stack=~\"$stack\", host=~\"$host\", project=~\"$project\", container=~\"$container\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
