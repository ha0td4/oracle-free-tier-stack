      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "time() - max by (host) (stack_backup_last_success_timestamp_seconds{stack=~\"$stack\"})",
          "legendFormat": "{{host}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 93600
              },
              {
                "color": "red",
                "value": 180000
              }
            ]
          },
          "mappings": [],
          "noValue": "no backup metrics",
          "displayName": "${__field.labels.host}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Last backup result",
      "description": "Result of the most recent backup run (stack_backup_success): OK or FAILED.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 31
      },
