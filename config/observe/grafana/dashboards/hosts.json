    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU by mode",
      "description": "CPU time per mode (idle left out), stacked, as a share of all cores.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (host, mode) (rate(node_cpu_seconds_total{job=\"node\", stack=~\"$stack\", host=~\"$host\", mode!=\"idle\"}[$__rate_interval])) / on (host) group_left () count by (host) (node_cpu_seconds_total{job=\"node\", stack=~\"$stack\", host=~\"$host\", mode=\"idle\"})",
          "legendFormat": "{{mode}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "custom": {
