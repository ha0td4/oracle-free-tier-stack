        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "1 - avg by (host) (rate(node_cpu_seconds_total{job=\"node\", stack=~\"$stack\", host=~\"$host\", mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false
