        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Swap used",
      "description": "Share of swap in use. Shows \"no swap\" when the host has none.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 14,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host) (node_memory_SwapTotal_bytes{job=\"node\", stack=~\"$stack\", host=~\"$host\"} - node_memory_SwapFree_bytes{job=\"node\", stack=~\"$stack\", host=~\"$host\"}) / max by (host) (node_memory_SwapTotal_bytes{job=\"node\", stack=~\"$stack\", host=~\"$host\"} > 0)",
          "legendFormat": "{{host}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
