    {
      "id": 12,
      "type": "timeseries",
      "title": "Disk I/O",
      "description": "Bytes read (up) and written (down) per block device.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (host, device) (rate(node_disk_read_bytes_total{job=\"node\", stack=~\"$stack\", host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{device}} read",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
