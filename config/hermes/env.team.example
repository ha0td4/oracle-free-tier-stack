# Lines to ADD to data/hermes/.env (created by `./stack.sh hermes setup`).
# Never commit the real .env.

# --- Discord: the team's main platform ---
DISCORD_BOT_TOKEN=
# Who may use the bot, by Discord ROLE (the main on/off switch for onboarding and offboarding).
# Role ID: Server Settings -> Roles -> ... -> Copy Role ID.
DISCORD_ALLOWED_ROLES=<role id hermes-user>,<role id hermes-admin>
# And/or specific users (OR-ed with roles):
# DISCORD_ALLOWED_USERS=<id>,<id>
# Channel for proactive messages (cron, reminders):
DISCORD_HOME_CHANNEL=<id #hermes-ops>
# Answer only in these channels (optional; empty = every channel the bot is invited to):
# DISCORD_ALLOWED_CHANNELS=<id>,<id>

# --- Telegram: optional, personal use. Runs next to Discord on the same gateway ---
# Separate allowlist: a Discord role does not grant access here (add the ID, or approve via pairing).
# Numeric ID: message @userinfobot on Telegram.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=<numeric id>,<numeric id>

# Search settings and the tokens of extra tools (MCP servers) are written here by the setup wizard and by `hermes mcp add`: see DEPLOY.md D6.

# --- Safety ---
# NEVER enable these on a bot that can run commands:
# GATEWAY_ALLOW_ALL_USERS=true
# DISCORD_ALLOW_ALL_USERS=true

# Optional, if you later want a confirmation before risky terminal commands:
# HERMES_EXEC_ASK=true
# Only allow file writes inside the workspace:
# HERMES_WRITE_SAFE_ROOT=/opt/data/workspace
