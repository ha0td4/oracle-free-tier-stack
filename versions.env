# Pinned versions. Edit a line, then run: ./stack.sh upgrade (backs up, applies, checks health).
# Read the release notes first. Undo with ./stack.sh rollback.

VER_CLOUDFLARED=2026.7.3
VER_N8N=2.43.6
VER_OMNIROUTE=3.8.51
VER_HERMES=v0.22.2
VER_SEARXNG=2026.8.5-1689cb1b5
VER_POCKET_ID=v2.18.0
VER_CRAWL4AI=0.9.5
VER_SOCKET_PROXY=v0.5.0
VER_HOMER=v26.4.2
VER_OPEN_WEBUI=v0.12.3     # full image, not -slim: -slim cannot read PDF or Office files without Tika/Docling
# Monitoring agents on every host (Alloy, blackbox). The native hub pins its own versions in host/hub/deploy-hub.sh.
VER_ALLOY=v1.21.0
VER_BLACKBOX=v0.29.0
# Postgres majors need dump/restore or pg_upgrade
VER_POSTGRES=18.6-alpine
VER_VALKEY=9.1.2-alpine

# Host binary, installed by ./stack.sh upgrade
RESTIC_VERSION=0.19.1
