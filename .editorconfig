# Same layout on every editor; .gitattributes keeps LF in git as well (the scripts run on Linux).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces are a line break in Markdown
[*.md]
trim_trailing_whitespace = false

[*.{json,mjs,js,css,html,yml,yaml,sh,alloy}]
indent_size = 2
