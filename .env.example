# ./stack.sh init copies this to .env and generates the random secrets. Back up .env (N8N_ENCRYPTION_KEY above all).

DOMAIN=example.com
TZ=UTC
STACK_TIER=standard            # standard | full | lite | agent (an extra host that only sends its metrics and logs)
CF_TUNNEL_TOKEN=
# Zero Trust team name (Settings → Team name and domain). Set before the first ./stack.sh up (IDENTITY.md F2)
CF_TEAM_NAME=
# Your email: the admin accounts are created with it (n8n, Open WebUI, Pocket ID; DEPLOY.md D5-D7, IDENTITY.md F1).
# Grafana on the hub gets the same email from deploy-hub.sh --admin-email.
ADMIN_EMAIL=

N8N_ENCRYPTION_KEY=__GENERATE__
# n8n owner (D5): re-applied on every start once ADMIN_EMAIL is set, so change these here and run ./stack.sh up.
# n8n only takes a bcrypt hash: ./stack.sh up writes it below as N8N_OWNER_PASSWORD_HASH and renews it when the password changes.
N8N_OWNER_PASSWORD=__GENERATE__
N8N_OWNER_FIRST_NAME=Admin
N8N_OWNER_LAST_NAME=Owner

OMNIROUTE_PASSWORD=__GENERATE__
OMNIROUTE_JWT_SECRET=__GENERATE__
OMNIROUTE_API_KEY_SECRET=__GENERATE__

# Hermes dashboard login. Keep these long (1-character values stop the dashboard from starting).
# For passkeys see config/hermes/dashboard-oidc.env.example; keep the password as the fallback.
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=__GENERATE__
HERMES_DASHBOARD_SECRET=__GENERATE__

POCKETID_ENCRYPTION_KEY=__GENERATE__
# Written by ./stack.sh up when it creates the Pocket ID admin. ACCESS: pasted into Cloudflare (F2). GRAFANA: saved to a file
# on the hub VM for deploy-hub.sh --grafana-oidc-secret-file (F3)
ACCESS_OIDC_CLIENT_SECRET=
GRAFANA_OIDC_CLIENT_SECRET=

# Open WebUI (chat.DOMAIN, DEPLOY.md D7). ./stack.sh up fills in the OIDC client lines (IDENTITY.md F5).
OPENWEBUI_SECRET_KEY=__GENERATE__
# First admin, created with ADMIN_EMAIL on the first start only; afterwards the password lives in Open WebUI (Settings → Account)
OPENWEBUI_ADMIN_PASSWORD=__GENERATE__
OPENWEBUI_OIDC_CLIENT_ID=
OPENWEBUI_OIDC_CLIENT_SECRET=
# Only seed a fresh install; afterwards Open WebUI keeps these in its Admin panel (D7)
OPENWEBUI_OMNIROUTE_KEY=
# An embedding model OmniRoute offers (for documents); also changeable in Admin → Settings → Documents
OPENWEBUI_EMBEDDING_MODEL=

SEARXNG_SECRET=__GENERATE__
CRAWL4AI_API_TOKEN=__GENERATE__

# Monitoring agents (DEPLOY.md D8, D9). The hub is native on its own VM (host/hub/deploy-hub.sh) and has no .env.
# This stack's name in Grafana (the stack label): the hosts of one stack share it, another stack on the same hub picks its own
STACK_NAME=oracle-stack
# This host's name in Grafana: the host label of its metrics and logs. Every host needs its own: the default is for the
# first one, so change it in the .env of every other host (agent tier), or their metrics and logs mix.
HOST_NAME=oracle-vm
# The hub's private IP in the VCN (Oracle Console → the instance → Private IPv4 address), where Alloy pushes.
# A host outside the VCN uses the hub's Tailscale IP instead.
OBSERVE_HUB=

# postgres and valkey profiles (full tier)
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=__GENERATE__
VALKEY_PASSWORD=__GENERATE__
